# Copie este arquivo para ".env" (nunca commitado, ver .gitignore) e ajuste
# para o caminho real na sua máquina. Nunca colocar o caminho real neste
# arquivo de exemplo nem em qualquer outro arquivo versionado.

PAINEL_FONTE_DOCUMENTOS=C:\caminho\para\a\pasta\de\documentos

# Caminho do banco SQLite deste projeto (metadados, não os documentos originais).
# Opcional — se omitido, usa "data/painel.db".
PAINEL_BANCO_DADOS=data/painel.db

# Endereço onde o servidor escuta. Opcional — se omitido, usa 127.0.0.1:8080.
# NUNCA colocar "0.0.0.0" aqui sem entender as implicações (ver SEGURANCA.md)
# — o painel não tem HTTPS nem proteção contra força bruta de login.
PAINEL_ENDERECO=127.0.0.1:8080

# Usuário criado automaticamente na primeira execução, só se ainda não
# existir NENHUM usuário cadastrado (nunca sobrescreve um já existente).
# Deixe em branco pra criar o primeiro usuário manualmente via:
#   painel.exe -criar-usuario "seu.nome"
# (mais seguro — a senha nunca fica escrita num arquivo em texto puro)
PAINEL_USUARIO_INICIAL=
PAINEL_SENHA_INICIAL=
